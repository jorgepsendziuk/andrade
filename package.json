{
  "name": "andrade-isencoes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd server && npm start",
    "deploy:cloudrun": "bash scripts/deploy-cloudrun.sh",
    "deploy": "bash scripts/deploy-firebase.sh",
    "deploy:firebase": "bash scripts/deploy-firebase.sh",
    "setup:firebase": "bash scripts/firebase-setup-hosting.sh",
    "setup:firebase-domain": "bash scripts/firebase-add-custom-domains.sh",
    "migrate:dns-firebase": "bash scripts/migrate-dns-firebase.sh",
    "wait:firebase-ssl": "bash scripts/firebase-wait-ssl.sh",
    "setup:email-redirect": "bash scripts/firebase-setup-email-redirect.sh",
    "teardown:loadbalancer": "bash scripts/teardown-loadbalancer.sh",
    "setup:media": "bash scripts/gcp-setup-media.sh",
    "setup:docs": "bash scripts/gcp-setup-docs.sh",
    "setup:ga4": "bash scripts/gcp-setup-ga4.sh",
    "setup:domain": "bash scripts/gcp-setup-domain.sh",
    "setup:billing": "bash scripts/gcp-setup-billing-export.sh",
    "setup:backup": "bash scripts/gcp-setup-backup.sh",
    "backup:daily": "npx tsx scripts/backup-daily.ts",
    "seed:admin-users": "CONTACTS_STORAGE=firestore npx tsx scripts/seed-admin-users.ts",
    "seed:test-process": "npx tsx scripts/seed-test-process.ts",
    "restore:content": "CONTACTS_STORAGE=firestore npx tsx scripts/restore-site-content.ts",
    "migrate:media": "npx tsx scripts/migrate-media-to-gcs.ts",
    "sync:media": "npx tsx scripts/sync-media-archive.ts",
    "test": "npm run test --prefix server && npm run test --prefix frontend",
    "test:server": "npm run test --prefix server",
    "test:frontend": "npm run test --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.13",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^24.13.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
