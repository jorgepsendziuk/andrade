{
  "hosting": [
    {
      "site": "smart-tractor-257319",
      "public": "hosting/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "andrade-isencoes",
            "region": "southamerica-east1"
          }
        }
      ],
      "headers": [
        {
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, s-maxage=3600"
            },
            {
              "key": "X-Robots-Tag",
              "value": "all"
            }
          ]
        },
        {
          "source": "/sitemap.xml",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=300"
            },
            {
              "key": "X-Robots-Tag",
              "value": "all"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|woff2|webp|jpg|jpeg|png|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "site": "andrade-email",
      "public": "hosting/email",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/",
          "destination": "https://sso.godaddy.com/?app=email&realm=pass",
          "type": 302
        },
        {
          "source": "**",
          "destination": "https://sso.godaddy.com/?app=email&realm=pass",
          "type": 302
        }
      ]
    }
  ]
}
