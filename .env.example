JWT_SECRET=altere-este-segredo-em-producao
SITE_URL=https://andradeisencoes.com.br
# Bucket GCS para fotos do site (fora do build). Rode: bash scripts/gcp-setup-media.sh
GCS_BUCKET=andrade-media
VITE_SITE_URL=https://andradeisencoes.com.br
# Google Analytics 4 — conta AndradeIsencoes (163733965), propriedade andradeisencoes.com.br (347102827)
# ID de medição (G-XXXXXXXX): Admin GA4 → Fluxos de dados → Web → ID de medição
VITE_GA4_PROPERTY_ID=347102827
VITE_GA_MEASUREMENT_ID=G-BM0PH4LDQG
# E-mails isentos do rate limit de login (vírgula para vários)
LOGIN_RATE_LIMIT_EXEMPT=jimxxx@gmail.com
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Gmail — envia DE andradeisencoescloud@gmail.com PARA comercial@andradeisencoes.com.br
# Senha de app: https://myaccount.google.com/apppasswords (conta andradeisencoescloud@gmail.com)
# No Cloud Run: guardar SMTP_PASS no Secret Manager (ver scripts/deploy-cloudrun.sh)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=andradeisencoescloud@gmail.com
SMTP_PASS=
SMTP_FROM=andradeisencoescloud@gmail.com
CONTACT_EMAIL=comercial@andradeisencoes.com.br
# Google Analytics Data API (painel admin — leitura de visitas)
GA4_PROPERTY_ID=347102827
# Exportação de faturamento → BigQuery (custos reais no painel admin)
# Rode: bash scripts/gcp-setup-billing-export.sh e habilite no console de faturamento
BILLING_BQ_DATASET=billing_export
BILLING_ACCOUNT_ID=017163-F935E4-FCF7C4
# Firebase Hosting (domínio customizado — substitui Load Balancer)
# SITE_DOMAIN=andradeisencoes.com.br
# JSON da service account (local) ou Secret Manager GA4_SERVICE_ACCOUNT_JSON no Cloud Run
GA4_SERVICE_ACCOUNT_JSON=
# Guia: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USERNAME=andradeconsultoriae
INSTAGRAM_PROFILE_URL=https://www.instagram.com/andradeconsultoriae
